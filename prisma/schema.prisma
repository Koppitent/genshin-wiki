// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TierListVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
  OFFICIAL
}

model Weapon {
	id          String   @id @default(cuid())

	name        String
	description String
	rarity      Int				//1-5 stars

	imageUrl    String

	weaponTypeId String
  weaponType   WeaponType @relation(fields: [weaponTypeId], references: [id])

	releaseVersion 	Float @default(1.0)
	baseAttack  		Float
}

model Character {
	id          String   @id @default(cuid())

	name        String	 @unique
	description String
	rarity      Int				//1-5 stars
	element     String 		//Anemo, Geo, Electro, Dendro, Hydro, Pyro, Cryo
	gender			String

	regionId    String?
	region 			Region? @relation(fields: [regionId], references: [id])

	imageUrl    String

	weaponTypeId String
  weaponType   WeaponType @relation(fields: [weaponTypeId], references: [id])

	tierListEntries TierListEntry[]

	releaseVersion 	Float @default(1.0)
	releaseDate		 	DateTime
	birthday     		DateTime
}

model Region {
	id   				String @id @default(cuid())
	name 				String
	imageUrl 		String
	description String

	characters Character[]
}

model WeaponType {
	id   String @id @default(cuid())
	name String

	weapons  Weapon[]
  characters Character[]
}

model ArtifactSet {
	id          					String   @id @default(cuid())

	name        					String
	setBonusDescription4 	String
	setBonusDescription2 	String
	rarity      					Int				//3-5 stars

	artifacts   					Artifact[]

	imageUrl    					String
}

model Artifact {
	id          String   @id @default(cuid())

	name        String
	description String
	rarity      Int				//3-5 stars

	artifactSetId String
	artifactSet   ArtifactSet @relation(fields: [artifactSetId], references: [id])

	imageUrl    String
}


//////////////////////////////////////////////////////
// AUTH (NextAuth.js)
//////////////////////////////////////////////////////

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

	profile       UserProfile? @relation
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique

  users UserProfile[]
}

///
// User Profile

model UserProfile {
  id        		String @id @default(cuid())

  userId    		String @unique
  user      		User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roles     		Role[]
  tierLists 		TierList[]

	tokenVersion 	Int @default(0) // increment this when changing the roles of a user to invalidate their JWTs

  createdAt 		DateTime @default(now())
  updatedAt 		DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TIER LIST SYSTEM
//////////////////////////////////////////////////////

model TierList {
  id          String @id @default(cuid())

  title       String
  description String?

  visibility  TierListVisibility @default(PRIVATE)

  profileId   String?
  profile     UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  entries     TierListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TierListEntry {
  id          String @id @default(cuid())

  tierListId  String
  tierList    TierList @relation(fields: [tierListId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  tier        String // SS, S, A, B, C, D
  position    Int    // order inside tier

  note        String?

  @@unique([tierListId, characterId])
  @@index([tierListId, tier])
}
