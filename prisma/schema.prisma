// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Weapon {
	id          String   @id @default(cuid())

	name        String
	description String
	rarity      Int				//1-5 stars

	imageUrl    String

	weaponTypeId String
  weaponType   WeaponType @relation(fields: [weaponTypeId], references: [id])

	releaseVersion 	Float @default(1.0)
	baseAttack  		Float
}

model Character {
	id          String   @id @default(cuid())

	name        String
	description String
	rarity      Int				//1-5 stars
	element     String 		//Anemo, Geo, Electro, Dendro, Hydro, Pyro, Cryo

	regionId    String?
	region 			Region? @relation(fields: [regionId], references: [id])

	imageUrl    String

	weaponTypeId String
  weaponType   WeaponType @relation(fields: [weaponTypeId], references: [id])

	releaseVersion 	Float @default(1.0)
	baseAttack  		Float
}

model Region {
	id   				String @id @default(cuid())
	name 				String
	imageUrl 		String
	description String

	characters Character[]
}

model WeaponType {
	id   String @id @default(cuid())
	name String

	weapons  Weapon[]
  characters Character[]
}

model ArtifactSet {
	id          					String   @id @default(cuid())

	name        					String
	setBonusDescription4 	String
	setBonusDescription2 	String
	rarity      					Int				//3-5 stars

	artifacts   					Artifact[]

	imageUrl    					String
}

model Artifact {
	id          String   @id @default(cuid())

	name        String
	description String
	rarity      Int				//3-5 stars

	artifactSetId String
	artifactSet   ArtifactSet @relation(fields: [artifactSetId], references: [id])

	imageUrl    String
}

// Authentication models for NextAuth.js
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

	roles         Role[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([provider, providerAccountId])
}
 
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@id([identifier, token])
}

model Role {
  id    String @id @default(cuid())
  name  String @unique

  users User[]
}
